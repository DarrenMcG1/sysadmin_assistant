[Unit]
Description=SysAdmin project organiser — scan ~/projects and rewrite estate.json
Documentation=file:///home/gaddi/projects/sysadmin_assistant/docs/adr/0001-project-registry.md
# Needs the database, not the monitoring daemon. Deliberately no
# After=sysadmin.service: the two are independent by design, and ordering
# them would make a stopped monitor delay the scan for no reason.
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
WorkingDirectory=/home/gaddi/projects/sysadmin_assistant
Environment=PATH=/home/gaddi/projects/sysadmin_assistant/.venv/bin:/usr/local/bin:/usr/bin
ExecStart=/home/gaddi/projects/sysadmin_assistant/.venv/bin/sysadmin-organiser
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sysadmin-organiser

# A scan walks forty git repositories. It is allowed to be slow; it is not
# allowed to hold the box.
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=idle
MemoryMax=512M
